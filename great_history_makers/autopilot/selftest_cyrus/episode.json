 "captions": {
  "transcript": "audio/transcript.txt",
  "words": "audio/words_aligned.json",
  "groups": [
   "In 539 BCE,",
   "Cyrus the Great turned his attention / to Babylon,",
   "one of the ancient world's / greatest cities.",
   "After the Persian / victory at Opis,",
   "Babylon came under / Persian control.",
   "Ancient accounts describe / the city's capture",
   "with little resistance, / though details differ.",
   "Cyrus entered Babylon",
   "and presented himself / as a legitimate king,",
   "honoring local traditions / and the god Marduk.",
   "The famous Cyrus Cylinder / records his royal claims",
   "and his restoration / of religious sites",
   "and displaced communities.",
   "It is an extraordinary / artifact,",
   "but not a modern declaration / of human rights.",
   "Babylon became part / of a vast Persian Empire.",
   "More than twenty-five / centuries later,",
   "the story of Cyrus / still raises questions",
   "about power, conquest,",
   "and how rulers wish / to be remembered."
  ],
  "style": "outline",
  "size": 62
 },
