# Copy to .env and replace every value. Never commit .env.
# Client API keys (comma-separated). Give each person/device its own key.
VRV_API_KEYS=replace-with-a-long-random-key
# At least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
VRV_TOKEN_SECRET=replace-with-48-random-characters-0123456789abcdef
POSTGRES_PASSWORD=replace-me
VRV_S3_ACCESS_KEY_ID=replace-me
VRV_S3_SECRET_ACCESS_KEY=replace-me-at-least-8-chars
VRV_RETENTION_HOURS=24
VRV_REQUIRE_HTTPS=false
# Measured throughput of your worker in source megapixels per second (for quotes).
VRV_THROUGHPUT_MP_PER_S=0.5
# Leave unset unless you actually charge for processing.
# VRV_PRICE_PER_GPU_MINUTE=
# VRV_CURRENCY=
