<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required by the Flutter tool for hot reload / debugging. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may talk to a local dev server over plain HTTP (e.g. http://10.0.2.2:8000).
         Release builds keep cleartext traffic disabled. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
