# Copy to .env for local development. NEVER commit real secrets.
FM_ENV=development
FM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fairmatch
FM_REDIS_URL=redis://localhost:6379/0
FM_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FM_MEDIA_URL_SECRET=change-me-too
FM_PUBLIC_BASE_URL=http://10.0.2.2:8000   # Android emulator -> host machine

# AI: mock (rule-based, offline) | anthropic (needs ANTHROPIC_API_KEY)
FM_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# Billing: dev (accepts "dev-*" tokens, refused in production) | google_play
FM_BILLING_MODE=dev
# FM_GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/play-service-account.json
# FM_GOOGLE_PLAY_PACKAGE_NAME=app.fairmatch
# FM_RTDN_SHARED_SECRET=

# Push: log | fcm
FM_PUSH_PROVIDER=log
# FM_FCM_PROJECT_ID=

# Storage: local | s3 (install boto3)
FM_STORAGE_BACKEND=local
