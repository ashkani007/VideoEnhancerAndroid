<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 Auto Backup. Scripts and settings are backed up; offline speech
     packs (40–53 MB each, re-downloadable) are excluded so the backup stays under
     the 25 MB Auto Backup limit, and per-device recognizer verdicts are excluded. -->
<full-backup-content>
    <exclude domain="file" path="vosk/" />
    <!-- Android 8–9 recordings live in app-specific external storage; videos are too large for Auto Backup. -->
    <exclude domain="external" path="Movies/" />
    <exclude domain="sharedpref" path="lensprompt_recognizer_verdicts.xml" />
</full-backup-content>
