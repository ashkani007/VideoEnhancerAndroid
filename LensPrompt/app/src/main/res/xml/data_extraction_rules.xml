<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-to-device transfer. Same policy as backup_rules.xml:
     scripts and settings move with the user; speech packs and per-device verdicts do not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vosk/" />
        <exclude domain="sharedpref" path="lensprompt_recognizer_verdicts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vosk/" />
        <exclude domain="sharedpref" path="lensprompt_recognizer_verdicts.xml" />
    </device-transfer>
</data-extraction-rules>
